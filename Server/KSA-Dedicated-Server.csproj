<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KSA.Multiplayer.DedicatedServer</RootNamespace>
    <Version>0.4.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>LatestMajor</RollForward>
    <PathMap>$(MSBuildProjectDirectory)=/_/Server</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- MemoryPack for message serialization (includes source generator) -->
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>

  <!-- Reference KSA DLLs from game directory -->
  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>$(MSBuildThisFileDirectory)../lib/KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.RakNet">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.RakNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Common">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.Core.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Logging">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.Core.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(MSBuildThisFileDirectory)../lib/CommunityToolkit.HighPerformance.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The native RakNet binary is NOT shipped. Brutal.RakNet.dll is loaded from the
       local KSA installation, so .NET probes that same folder for its native dependency
       and finds libRakNetDLL.so (Linux) or RakNetDLL.dll (Windows) there. -->

</Project>
