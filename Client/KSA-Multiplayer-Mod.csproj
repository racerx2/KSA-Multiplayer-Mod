<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KSA.Mods.Multiplayer</RootNamespace>
    <AssemblyName>Multiplayer</AssemblyName>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PathMap>$(MSBuildProjectDirectory)=/_/Client</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Exclude archive folder from compilation -->
  <ItemGroup>
    <Compile Remove="archive\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet Packages -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="MemoryPack.Generator" Version="1.21.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- KSA Core References -->
    <Reference Include="KSA">
      <HintPath>$(MSBuildThisFileDirectory)../lib/KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Planet.Core">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Planet.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Planet.Render.Core">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Planet.Render.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Brutal Framework References -->
    <Reference Include="Brutal.ImGui">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.ImGui.Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.ImGui.Extensions">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.ImGui.Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.RakNet">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.RakNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.Core.Common">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.Core.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.Core.Logging">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.Core.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.Numerics">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepuUtilities">
      <HintPath>$(MSBuildThisFileDirectory)../lib/BepuUtilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="Brutal.Core.Strings">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Tomlet">
      <HintPath>$(MSBuildThisFileDirectory)../lib/Tomlet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="MemoryPack.Core">
      <HintPath>$(MSBuildThisFileDirectory)../lib/MemoryPack.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- StarMap API for mod loader compatibility -->
    <Reference Include="StarMap.API">
      <HintPath>$(MSBuildThisFileDirectory)../lib/StarMap.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Message Text="Multiplayer mod compiled successfully!" Importance="high" />
    <Message Text="Output: $(TargetPath)" Importance="high" />
  </Target>

</Project>
